# ===================================================
# TEXAS WEBCODERS - PRODUCTION & LOCAL CONFIGURATION
# ===================================================

# 1. Lead Notification Email (Where new leads & bookings are sent)
NOTIFICATION_EMAIL="info@texaswebcoders.com"

# 2. SMTP Mail Server Configuration (Gmail, Hostinger, SendGrid, AWS SES)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="leads@texaswebcoders.com"

# 3. Gemini AI Key (Optional for live Gemini dynamic completions)
GEMINI_API_KEY=""

# 4. App URL
APP_URL="https://texaswebcoders.com"

